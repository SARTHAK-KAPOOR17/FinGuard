# Transaction Simulator Environment Variables
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Ingestion target
INGESTION_API_URL=http://localhost:3001/transactions
INGESTION_BATCH_API_URL=http://localhost:3001/transactions/batch

# Simulator defaults
DEFAULT_RATE=10
DEFAULT_DURATION=30
FRAUD_RATIO=0.05
