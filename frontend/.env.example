# FinGuard Dashboard Environment Variables
# NOTE: VITE_* variables are embedded in the browser client bundle.
# In production, never expose admin API keys in client-side code; use an authenticated BFF/session proxy.

VITE_API_URL=http://localhost:3003
VITE_SOCKET_URL=http://localhost:3003
VITE_ADMIN_API_KEY=your-admin-api-key-here
