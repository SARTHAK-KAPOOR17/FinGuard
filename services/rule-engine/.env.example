# Rule Engine Service Environment Variables
PORT=3002
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=finguard-rule-engine-service
KAFKA_CONSUMER_GROUP_ID=rule-engine-group
KAFKA_RAW_TOPIC=transactions.raw
KAFKA_FLAGGED_TOPIC=transactions.flagged

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
