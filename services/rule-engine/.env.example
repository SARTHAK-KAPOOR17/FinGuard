# Rule Engine Service Environment Variables
PORT=3002
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Security & API Key
ADMIN_API_KEY=your-admin-api-key-here-change-in-production

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=finguard-rule-engine-service
KAFKA_CONSUMER_GROUP_ID=rule-engine-group
KAFKA_RAW_TOPIC=transactions.raw
KAFKA_FLAGGED_TOPIC=transactions.flagged
KAFKA_FROM_BEGINNING=false

# MongoDB Configuration
MONGO_URI=mongodb://root:example@localhost:27017/finguard?authSource=admin

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
