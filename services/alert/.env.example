# Alert Service Environment Variables
PORT=3003
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Security & API Key
ADMIN_API_KEY=your-admin-api-key-here-change-in-production

# Dashboard CORS Configuration (no wildcards)
DASHBOARD_ORIGIN=http://localhost:3000

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=finguard-alert-service
KAFKA_CONSUMER_GROUP_ID=alert-service-group
KAFKA_FLAGGED_TOPIC=transactions.flagged
KAFKA_FROM_BEGINNING=false

# MongoDB Configuration
MONGO_URI=mongodb://root:example@localhost:27017/finguard?authSource=admin
