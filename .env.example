# FinGuard Root Environment Variables (Example)

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=finguard-app
KAFKA_RAW_TOPIC=transactions.raw
KAFKA_FLAGGED_TOPIC=transactions.flagged

# MongoDB Configuration
MONGO_URI=mongodb://root:example@localhost:27017/finguard?authSource=admin
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_INITDB_DATABASE=finguard

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Service Ports
PORT_GATEWAY=3000
PORT_INGESTION=3001
PORT_RULE_ENGINE=3002
PORT_ALERT=3003
PORT_AUTH=3004
